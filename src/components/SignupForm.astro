---
// src/components/SignupForm.astro

const { path } = Astro.props;
---
<form id="signup-form" class="max-w-screen-lg mx-auto mt-12" data-path={path}>
  <!-- Campo Nombres -->
  <div class="relative z-0 w-full mb-5 group">
    <input
      type="text"
      id="first_name"
      name="first_name"
      class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer"
      placeholder=" "
      required
    />
    <label
      for="first_name"
      class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
    >Nombres</label>
    <span class="text-red-500 text-xs hidden" id="first_name_error">Requerido</span>
  </div>

  <!-- Campo Apellidos -->
  <div class="relative z-0 w-full mb-5 group">
    <input
      type="text"
      id="last_name"
      name="last_name"
      class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer"
      placeholder=" "
      required
    />
    <label
      for="last_name"
      class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
    >Apellidos</label>
    <span class="text-red-500 text-xs hidden" id="last_name_error">Requerido</span>
  </div>

  <!-- Campo Email -->
  <div class="relative z-0 w-full mb-5 group">
    <input
      type="email"
      id="email"
      name="email"
      class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer"
      placeholder=" "
      required
    />
    <label
      for="email"
      class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
    >Email</label>
    <span class="text-red-500 text-xs hidden" id="email_error">Requerido</span>
  </div>

  <!-- Campo Tipo de Documento -->
  <div class="relative z-0 w-full mb-5 group">
    <input
      type="text"
      id="type_id"
      name="type_id"
      class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer"
      placeholder=" "
      required
    />
    <label
      for="type_id"
      class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
    >Tipo de Documento</label>
    <span class="text-red-500 text-xs hidden" id="type_id_error">Requerido</span>
  </div>

  <!-- Campo Número de Documento -->
  <div class="relative z-0 w-full mb-5 group">
    <input
      type="text"
      id="document_id"
      name="document_id"
      class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer"
      placeholder=" "
      required
    />
    <label
      for="document_id"
      class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
    >Número de Documento</label>
    <span class="text-red-500 text-xs hidden" id="document_id_error">Requerido</span>
  </div>

  <!-- Campo Edad -->
  <div class="relative z-0 w-full mb-5 group">
    <input
      type="number"
      id="age"
      name="age"
      class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer"
      placeholder=" "
      required
    />
    <label
      for="age"
      class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
    >Edad</label>
    <span class="text-red-500 text-xs hidden" id="age_error">Requerido</span>
  </div>

  <!-- Campo Contraseña -->
  <div class="relative z-0 w-full mb-5 group">
    <input
      type="password"
      id="password"
      name="password"
      class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer"
      placeholder=" "
      required
    />
    <label
      for="password"
      class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
    >Contraseña</label>
    <span class="text-red-500 text-xs hidden" id="password_error">Requerido</span>
  </div>

  <!-- Botón de Envío -->
  <button
    type="submit"
    class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 mt-4"
    id="submit-button"
  >
    Submit
  </button>

  <!-- Mensaje de Éxito -->
  <div id="success-message" class="text-green-500 text-sm mt-4 hidden">
    Registro exitoso.
  </div>

  <!-- Mensaje de Error -->
  <div id="server-error-message" class="text-red-500 text-sm mt-4 hidden">
    Ocurrió un error al enviar el formulario.
  </div>

  <!-- Scripts de JavaScript para Manejar el Formulario -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('signup-form');
      if (!form) return;
      const submitButton = document.getElementById('submit-button');
      const successMessage = document.getElementById('success-message');
      const serverErrorMessage = document.getElementById('server-error-message');
      const path = form.dataset.path;



      form.addEventListener('submit', async (e) => {
        e.preventDefault(); // Previene el envío predeterminado

        // Limpiar mensajes anteriores
        if (successMessage) successMessage.classList.add('hidden');
        if (serverErrorMessage) serverErrorMessage.classList.add('hidden');

        // Recolectar los datos del formulario
        const formElement = document.getElementById('signup-form') as HTMLFormElement;
        const formData = new FormData(formElement);
        const data = Object.fromEntries(formData.entries());

        // Validación manual de campos
        let hasError = false;

        // Lista de campos requeridos
        const requiredFields = ['first_name', 'last_name', 'email', 'type_id', 'document_id', 'age', 'password'];

        requiredFields.forEach((field) => {
          const input = document.getElementById(field);
          const errorSpan = document.getElementById(`${field}_error`);
          const fieldValue = data[field] instanceof File ? '' : (data[field] as string).trim();
          if (errorSpan) {
            if (!fieldValue) {
              errorSpan.classList.remove('hidden');
              hasError = true;
            } else {
              errorSpan.classList.add('hidden');
            }
          }
          
          // Validación adicional para el email
          const emailValue = data.email instanceof File ? '' : (data.email as string).trim();
          if (formData && emailValue && !/\S+@\S+\.\S+/.test(emailValue)) {
            const emailError = document.getElementById('email_error');
            if (emailError) {
                emailError.textContent = 'Email inválido';
                emailError.classList.remove('hidden');
            }
            hasError = true;
          }

        // Validación adicional para la edad
        const ageValue = parseInt(data.age as string, 10);
        const ageError = document.getElementById('age_error');
        if (isNaN(ageValue) || ageValue <= 0) {
          if (ageError) {
            ageError.textContent = 'Edad inválida';
            ageError.classList.remove('hidden');
          }
          hasError = true;
        }

        // Validación adicional para la contraseña
        const passwordValue = data.password instanceof File ? '' : (data.password as string);
        if (passwordValue && passwordValue.length < 6) {
          const passwordError = document.getElementById('password_error');
          if (passwordError) {
            passwordError.textContent = 'La contraseña debe tener al menos 6 caracteres';
            passwordError.classList.remove('hidden');
          }
          hasError = true;
        }

        if (hasError) return; // Si hay errores, no enviar el formulario

        // Deshabilitar el botón de envío para prevenir múltiples envíos
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
          submitButton.textContent = 'Enviando...';
        }

        try {
          const response = await fetch(`/api/v1${path}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data),
          });

          if (response.ok) {
            const result = await response.json();
            console.log('Respuesta del servidor:', result);
            successMessage.classList.remove('hidden');
            form.reset(); // Resetear el formulario
          } else {
            const error = await response.json();
            console.error('Error del servidor:', error);
            serverErrorMessage.classList.remove('hidden');
          }
        } catch (error) {
          console.error('Error en la solicitud:', error);
          serverErrorMessage.classList.remove('hidden');
        } finally {
          // Rehabilitar el botón de envío
          submitButton.disabled = false;
          submitButton.textContent = 'Submit';
        }
      });
    });
});
  </script>
</form>
